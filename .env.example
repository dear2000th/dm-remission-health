# ==========================================
# DM Remission Health Tracker Environment Configuration
# ==========================================

# Server Port
PORT=3000

# JWT Authentication Secret Key (Minimum 32 characters for security)
JWT_SECRET=dm_remission_super_secure_key_2026_change_me_in_production!@#$

# Database Engine: 'firestore' or 'sqlite'
# If set to 'firestore', the app connects to Google Cloud Firestore
# If credentials are not yet provided, it automatically falls back safely to local SQLite
DATABASE_TYPE=firestore

# ==========================================
# Firebase / Firestore Setup (2 Options)
# ==========================================
# OPTION 1 (Recommended for local dev):
# Download serviceAccountKey.json from Firebase Console -> Project Settings -> Service Accounts
# Place serviceAccountKey.json in the project root directory.

# OPTION 2 (Recommended for GitHub / Cloud Deployment):
# Pass credentials directly as environment variables:
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
